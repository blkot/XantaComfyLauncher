<ui:FluentWindow x:Class="XantaComfyLauncher.Desktop.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
                 Title="设置"
                 Width="980" Height="780"
                 MinWidth="820" MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 Background="{StaticResource WindowBackgroundBrush}"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="设置" Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="实例启动、启动器更新、托盘和监控选项" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ComfyUI 实例" Style="{StaticResource CardTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="实例路径" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding InstancePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseButton_Click" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="端口" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <RadioButton Grid.Column="2" Content="仅本机 127.0.0.1" IsChecked="{Binding IsLocal, Mode=TwoWay}" Margin="18,0,16,0" VerticalAlignment="Center" />
                            <RadioButton Grid.Column="3" Content="局域网 0.0.0.0" IsChecked="{Binding IsLan, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="启动选项" Style="{StaticResource CardTitleStyle}" />
                        <CheckBox Content="启用 SageAttention" IsChecked="{Binding UseSageAttention, Mode=TwoWay}" Margin="0,3" />
                        <CheckBox Content="启用 FP16 累加加速（--fast fp16_accumulation）" IsChecked="{Binding UseFp16Accumulation, Mode=TwoWay}" Margin="0,3" />
                        <CheckBox Content="ComfyUI 就绪后自动打开浏览器" IsChecked="{Binding AutoOpenBrowser, Mode=TwoWay}" Margin="0,3" />
                        <CheckBox Content="切换 ComfyUI 版本后同步 Python 依赖" IsChecked="{Binding UpdateDependencies, Mode=TwoWay}" Margin="0,3" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="额外参数" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="启动器更新" Style="{StaticResource CardTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="更新通道" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LauncherChannels}" SelectedItem="{Binding LauncherChannel, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="stable / beta" Style="{StaticResource MutedTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox Content="启动时检查启动器更新" IsChecked="{Binding CheckLauncherUpdates, Mode=TwoWay}" Margin="0,12,0,3" />
                        <CheckBox Content="自动下载更新，但不自动安装" IsChecked="{Binding AutoDownloadLauncherUpdates, Mode=TwoWay}" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="托盘与监控" Style="{StaticResource CardTitleStyle}" />
                        <CheckBox Content="最小化到系统托盘" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,3" />
                        <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" Margin="0,3" />
                        <CheckBox Content="ComfyUI 意外退出后自动重启" IsChecked="{Binding AutoRestartOnCrash, Mode=TwoWay}" Margin="0,3" />
                        <CheckBox Content="启动前显存不足预警" IsChecked="{Binding WarnLowVram, Mode=TwoWay}" Margin="0,3" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显存预警阈值" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding VramThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="MB" Style="{StaticResource MutedTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
