<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XantaComfyLauncher</AssemblyName>
    <RootNamespace>XantaComfyLauncher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationIcon>Assets\XantaComfyLauncher.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Version>0.1.18</Version>
    <Product>XantaComfyLauncher</Product>
    <Description>ComfyUI instance launcher with isolated app and instance update channels.</Description>
    <Authors>Xanta</Authors>
    <Company>Xanta</Company>
    <Copyright>Copyright © Xanta</Copyright>
    <RepositoryUrl>https://github.com/blkot/XantaComfyLauncher</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Bootstrapper\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="XantaComfyLauncher.Wpf\**\*.cs" />
    <EmbeddedResource Remove="Bootstrapper\**\*" />
    <EmbeddedResource Remove="artifacts\**\*" />
    <EmbeddedResource Remove="XantaComfyLauncher.Wpf\**\*" />
    <None Remove="Bootstrapper\**\*" />
    <None Remove="XantaComfyLauncher.Wpf\**\*" />
    <Page Remove="Bootstrapper\**\*" />
    <Page Remove="XantaComfyLauncher.Wpf\**\*" />
    <ApplicationDefinition Remove="XantaComfyLauncher.Wpf\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\scan_node_conflicts.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
