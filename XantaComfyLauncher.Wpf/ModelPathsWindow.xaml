<ui:FluentWindow x:Class="XantaComfyLauncher.Desktop.ModelPathsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
                 Title="模型路径管理"
                 Width="1180" Height="780"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 Background="{StaticResource WindowBackgroundBrush}"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="46%" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="模型路径管理" Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,16,0,12">
            <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" />
            <Button Content="打开选中目录" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenSelected}" Click="OpenButton_Click" />
            <Button Content="保存 YAML" Style="{StaticResource PrimaryButtonStyle}" Click="SaveYamlButton_Click" />
            <Button Content="创建 Junction" Style="{StaticResource SecondaryButtonStyle}" Click="JunctionButton_Click" />
            <Button Content="迁移目录" Style="{StaticResource SecondaryButtonStyle}" Click="MigrateButton_Click" />
        </WrapPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Paths}"
                  SelectedItem="{Binding SelectedPath, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="{StaticResource CardBackgroundBrush}"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  RowHeight="32"
                  MouseDoubleClick="PathsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="180" />
                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                <DataGridTextColumn Header="状态" Binding="{Binding Detail}" Width="230" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="extra_model_paths.yaml" Style="{StaticResource CardTitleStyle}" />
                <TextBox Grid.Row="1"
                         Text="{Binding YamlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="#15181E"
                         Foreground="#DCE0E6"
                         BorderBrush="{StaticResource CardBorderBrush}"
                         BorderThickness="1" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="保存 YAML 前会自动备份；Junction 和目录迁移需要明确确认；跨卷迁移只复制，不删除源目录。"
                   Style="{StaticResource MutedTextStyle}" Margin="2,12,0,0" TextWrapping="Wrap" />
    </Grid>
</ui:FluentWindow>
