<ui:FluentWindow x:Class="XantaComfyLauncher.Desktop.QueueWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
                 Title="ComfyUI 队列管理"
                 Width="1100" Height="700"
                 MinWidth="820" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 Background="{StaticResource WindowBackgroundBrush}"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="队列管理" Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" />
                <Button Content="中断当前" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanInterrupt}" Click="InterruptButton_Click" />
                <Button Content="清空等待" Style="{StaticResource SecondaryButtonStyle}" Click="ClearButton_Click" />
                <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDelete}" Click="DeleteButton_Click" />
                <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ExecutionStatus}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExecutionNode}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ExecutionDetail}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Value="{Binding ExecutionPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource MetricProgressStyle}" Height="10" />
                <TextBlock Text="{Binding ExecutionError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="{StaticResource CardBackgroundBrush}"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  RowBackground="{StaticResource CardBackgroundBrush}"
                  AlternatingRowBackground="#232833"
                  HorizontalGridLinesBrush="#303642"
                  VerticalGridLinesBrush="#303642"
                  SelectionMode="Single"
                  FontSize="12"
                  RowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="80" />
                <DataGridTextColumn Header="Prompt ID" Binding="{Binding PromptId}" Width="250" />
                <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="80" />
                <DataGridTextColumn Header="节点数" Binding="{Binding NodeCount}" Width="80" />
                <DataGridTextColumn Header="内容" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="队列每 2 秒刷新；实时节点进度来自 WebSocket。中断只影响当前任务，清空/删除只作用于等待队列。"
                   Style="{StaticResource MutedTextStyle}" Margin="2,12,0,0" TextWrapping="Wrap" />
    </Grid>
</ui:FluentWindow>
